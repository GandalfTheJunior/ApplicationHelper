          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "evidence"
      ],
      "title": "Skill",
      "type": "object"
    },
    "WorkExperience": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "employer": {
          "minLength": 1,
          "title": "Employer",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "responsibilities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Responsibilities",
          "type": "array"
        },
        "start_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Period"
        },
        "end_period": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Period"
        },
        "achievements": {
          "items": {
            "$ref": "#/$defs/Achievement"
          },
          "title": "Achievements",
          "type": "array"
        }
      },
      "required": [
        "id",
        "employer",
        "title"
      ],
      "title": "WorkExperience",
      "type": "object"
    }
